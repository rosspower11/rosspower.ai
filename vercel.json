{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "web": { "root": "apps/web", "framework": "nextjs" },
    "links": { "root": "apps/links", "framework": "nextjs" }
  },
  "rewrites": [
    {
      "source": "/(.*)",
      "has": [{ "type": "host", "value": "(?:preview\\.)?links\\.rosspower\\.ai" }],
      "destination": { "service": "links" }
    },
    { "source": "/(.*)", "destination": { "service": "web" } }
  ]
}
